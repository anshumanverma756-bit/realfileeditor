---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/#pdf-tools", label: "PDF" },
  { href: "/#image-tools", label: "Image" },
  { href: "/#document-tools", label: "Document" },
  { href: "/#pricing", label: "Pricing" },
];
---

<header class="sticky top-0 z-40 border-b border-[var(--line)] bg-[var(--bg)]/85 backdrop-blur">
  <div class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <span class="grid place-items-center h-8 w-8 border border-[var(--accent)] text-[var(--accent)] font-mono text-xs">RF</span>
      <span class="font-display font-semibold text-[15px] tracking-tight">realfileeditor</span>
    </a>

    <nav class="hidden md:flex items-center gap-7 font-mono text-[13px] text-[var(--fg-muted)]">
      {links.map((l) => (
        <a href={l.href} class="hover:text-[var(--fg)] transition-colors">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a
        href="/compress-pdf"
        class="hidden sm:inline-flex items-center h-9 px-4 bg-[var(--accent)] text-white text-[13px] font-medium hover:opacity-90 transition-opacity"
      >
        Open a tool
      </a>
    </div>
  </div>
</header>
