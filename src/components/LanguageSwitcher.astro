---
import { LANGUAGES } from "../lib/i18n";
---

<select
  id="lang-select"
  aria-label="Choose language"
  class="h-9 border border-[var(--line)] bg-[var(--bg)] text-[var(--fg)] text-xs font-mono px-2 cursor-pointer hover:border-[var(--accent)] transition-colors"
>
  {LANGUAGES.map((l) => (
    <option value={l.code}>{l.label}</option>
  ))}
</select>

<script>
  const select = document.getElementById("lang-select") as HTMLSelectElement | null;
  select?.addEventListener("change", () => {
    const code = select.value;
    localStorage.setItem("rfe-lang", code);
    (window as any).__rfeApplyLang?.(code);
  });
</script>
