---
import PdfCompressorTool from "./PdfCompressorTool";
import FileConvertAnimation from "./FileConvertAnimation.astro";
---

<section class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-5 pt-16 md:pt-24 pb-16">
    <div class="grid lg:grid-cols-[1fr_340px] gap-12 items-start">
      <div>
        <div class="max-w-2xl">
          <p class="font-mono text-xs uppercase tracking-wider text-[var(--accent)] mb-4 flex items-center gap-2 animate-rise">
            <span class="relative h-1.5 w-1.5 inline-block">
              <span class="signal-dot absolute inset-0 opacity-40"></span>
              <span class="relative h-1.5 w-1.5 bg-[var(--accent)] inline-block"></span>
            </span>
            <span data-i18n="hero.eyebrow">No sign-up · files auto-delete</span>
          </p>

          <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight leading-[1.05]">
            <span class="inline-block animate-rise" style="animation-delay: 60ms" data-i18n="hero.title1">Your complete</span><br />
            <span class="inline-block animate-rise" style="animation-delay: 160ms" data-i18n="hero.title2">online file toolkit.</span>
          </h1>

          <p
            data-i18n="hero.subtitle"
            class="mt-6 text-lg text-[var(--fg-muted)] max-w-xl animate-rise"
            style="animation-delay: 260ms"
          >
            Convert, compress, merge and split files in seconds — and instead of guessing at "low, medium,
            high," you drag a gauge to the exact size you want and we hit it.
          </p>
        </div>

        <div class="mt-12 max-w-2xl animate-rise" style="animation-delay: 360ms">
          <PdfCompressorTool client:load />
          <p class="mt-4 font-mono text-[11px] text-[var(--fg-muted)]">
            This is the live Compress PDF tool. Looking for another format? See all tools below.
          </p>
        </div>
      </div>

      <!-- On mobile this naturally falls below the tool (single-column grid);
           from lg upward it becomes the right-hand column, using the space
           the earlier broken sweep effect was in. -->
      <div class="animate-rise pt-2 lg:pt-8" style="animation-delay: 200ms">
        <FileConvertAnimation />
      </div>
    </div>
  </div>

  <div class="tick-rule mx-5 md:mx-0"></div>
</section>
