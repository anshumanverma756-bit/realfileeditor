---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ToolsGrid from "../components/ToolsGrid.astro";
import Features from "../components/Features.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import FaqSection from "../components/FaqSection.astro";
import { HOME_COMPRESS_FAQS, GLOBAL_FAQS, toFaqJsonLd, SITE } from "../lib/site";

const faqs = [...HOME_COMPRESS_FAQS, ...GLOBAL_FAQS];
---

<BaseLayout
  title="realfileeditor — Compress, Convert, Merge & Split Files Online"
  description="Compress PDF, merge PDF, split PDF and convert images and documents online — free, with no sign-up. Set the exact output file size yourself instead of picking a preset."
  path="/"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: SITE.name,
      url: SITE.url,
      applicationCategory: "Utility",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      description: SITE.description,
    },
    toFaqJsonLd(faqs),
  ]}
>
  <Hero />
  <ToolsGrid />
  <Features />
  <Testimonials />
  <Pricing />
  <FaqSection faqs={faqs} title="Compress PDF — frequently asked questions" />
</BaseLayout>
