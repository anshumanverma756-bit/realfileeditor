---
import BaseLayout from "../layouts/BaseLayout.astro";
import WatermarkPdfTool from "../components/WatermarkPdfTool";
import FaqSection from "../components/FaqSection.astro";
import RelatedTools from "../components/RelatedTools.astro";
import { toFaqJsonLd } from "../lib/site";

const faqs = [
  { q: "Can I set the watermark opacity?", a: "Yes — drag the opacity slider from faint to bold before generating the file." },
  { q: "Can I add a logo instead of text?", a: "Not yet — image watermarks are on the roadmap. For now the tool stamps diagonal text across every page." },
];
---

<BaseLayout
  title="Add Watermark to PDF Online Free — realfileeditor"
  description="Stamp a text watermark across every page of a PDF online, free, right in your browser."
  path="/watermark-pdf"
  jsonLd={toFaqJsonLd(faqs)}
>
  <section class="mx-auto max-w-3xl px-5 pt-14 pb-6 text-center">
    <p class="font-mono text-xs uppercase tracking-wider text-[var(--accent)] mb-3">Free · No sign-up</p>
    <h1 class="font-display text-4xl md:text-5xl font-semibold tracking-tight">Add a watermark to a PDF</h1>
    <p class="mt-4 text-[var(--fg-muted)] text-lg">Stamp diagonal text across every page — set the wording and opacity yourself.</p>
  </section>

  <section class="mx-auto max-w-2xl px-5 pb-16">
    <WatermarkPdfTool client:load />
  </section>

  <FaqSection faqs={faqs} title="Watermark PDF — FAQ" />
  <RelatedTools slugs={["compress-pdf", "rotate-pdf", "merge-pdf"]} />
</BaseLayout>
